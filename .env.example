# Copy to .env and fill in your credentials.

# App
DEBUG=false
PORT=8000
# Comma-separated browser origins allowed by CORS ("*" = any origin)
CORS_ORIGINS=*

# Auth: clients send this as X-API-Key (or Bearer). The frontend's BACKEND_API_KEY must match.
AUTH_ENABLED=true
API_KEY=change-me-to-a-long-random-string
# Optional: verify Supabase-issued JWTs (Project Settings -> API -> JWT secret)
SUPABASE_JWT_SECRET=

# PostgreSQL
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/customer_support

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_base

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Cross-Encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5

# Retrieval
HYBRID_DENSE_WEIGHT=0.5
HYBRID_SPARSE_WEIGHT=0.5
RRF_K=60
RETRIEVAL_TOP_K=20

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.2

# LangGraph
MAX_RETRIES=1

# Opik
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=ai-customer-support
