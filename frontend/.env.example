# Generate a random secret: `openssl rand -base64 32`
AUTH_SECRET=****

# FastAPI RAG backend (required). Use the public https:// URL on Render.
BACKEND_API_URL=http://localhost:8000
# Must match the backend's API_KEY / BACKEND_API_KEY
BACKEND_API_KEY=****

# PostgreSQL for users, chats, and messages
POSTGRES_URL=****

# Optional: Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: generate chat titles with Groq (otherwise derived from the question)
GROQ_API_KEY=

# Optional: resumable streams and IP rate limiting
REDIS_URL=
